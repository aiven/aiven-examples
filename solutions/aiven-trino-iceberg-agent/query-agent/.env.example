# query-agent configuration.
#
# LOCAL dev: copy to .env, fill in, then run (compose reads .env).
# Aiven Apps: set these as the app's env vars / secrets in the Aiven Apps setup.
# Never commit real values — .env is git-ignored.

# --- Amazon Bedrock ---
# Access key for the query-agent-bedrock IAM user (see setup-bedrock.sh).
export AWS_ACCESS_KEY_ID="<AccessKeyId>"
export AWS_SECRET_ACCESS_KEY="<SecretAccessKey>"
export AWS_REGION="eu-west-1"
export BEDROCK_MODEL_ID="eu.anthropic.claude-sonnet-4-6"

# --- Trino MCP endpoint (from query-app) ---
# Local (both on your machine): http://localhost:9097/mcp
# Aiven Apps: the externally-exposed mcp-trino URL — the public host (which
# already encodes the port as "-9097") PLUS the "/mcp" path, no ":port" suffix,
# e.g. https://<uuid>-9097.eur-1.aiven.app/mcp
export TRINO_MCP_URL="http://localhost:9097/mcp"

# --- MCP endpoint auth (when query-app has MCP_OAUTH_ENABLED=true) ---
# Preferred: give query-agent the SAME shared HMAC secret as query-app and let it
# mint a fresh short-lived JWT per request (never expires out from under you).
export MCP_JWT_SECRET=""
# aud/iss must match query-app's OIDC_AUDIENCE / OIDC_ISSUER. Defaults shown.
export MCP_JWT_AUDIENCE="trino-mcp"
export MCP_JWT_ISSUER="aiven-query-agent"
# Alternative: paste a ready-made bearer token instead of the secret. Takes
# precedence over MCP_JWT_SECRET if set, but it WILL expire. Leave empty to mint.
export TRINO_MCP_JWT=""
