# Root .env — consolidates every variable the full-stack root compose.yaml needs.
#
#   cp .env.example .env   # fill in real values
#   docker compose up --build
#
# Compose reads this file automatically for ${VAR} interpolation. Never commit
# real values — .env is git-ignored. (On Aiven Apps you set these per service in
# the app setup instead; this file is for local dev only.)

# --- Kafka (live-orders) ---
export KAFKA_SERVICE_URI="<your-kafka-sasl-ssl-host>:<port>"
export KAFKA_USERNAME="avnadmin"
export KAFKA_PASSWORD="<your-kafka-password>"
export KAFKA_TOPIC="order"
export ORDERS_PER_MINUTE="100"

# --- Snowflake Open Catalog (query-app / Trino) ---
export ICEBERG_CATALOG_URI="https://<account>.us-west-2.snowflakecomputing.com/polaris/api/catalog"
export ICEBERG_OAUTH_CREDENTIAL="<client-id>:<client-secret>"
export ICEBERG_OAUTH_SCOPE="PRINCIPAL_ROLE:<your-principal-role>"
export ICEBERG_WAREHOUSE="<catalog-name>"

# --- Trino MCP endpoint auth (query-app) ---
# Local dev: leave disabled. Exposed deployment: set true + a strong secret
# (openssl rand -hex 32); query-agent must present a JWT signed with the same
# secret whose aud/iss match below.
export MCP_OAUTH_ENABLED="false"
export MCP_JWT_SECRET=""
export MCP_JWT_AUDIENCE="trino-mcp"
export MCP_JWT_ISSUER="aiven-query-agent"

# --- Amazon Bedrock (query-agent) ---
# Access key for the query-agent-bedrock IAM user (see query-agent/setup-bedrock.sh).
export AWS_ACCESS_KEY_ID="<AccessKeyId>"
export AWS_SECRET_ACCESS_KEY="<SecretAccessKey>"
export AWS_REGION="eu-west-1"
export BEDROCK_MODEL_ID="eu.anthropic.claude-sonnet-4-6"

# --- query-agent -> query-app MCP wiring ---
# Defaults to the compose service name; override only to point elsewhere.
# If MCP_OAUTH_ENABLED=true, set TRINO_MCP_JWT to a token signed with MCP_JWT_SECRET.
export TRINO_MCP_URL="http://query-app:9097/mcp"
export TRINO_MCP_JWT=""
