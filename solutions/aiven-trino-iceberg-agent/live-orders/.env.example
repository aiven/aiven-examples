# live-orders configuration.
#
# For LOCAL dev: copy to .env, fill in values, then `source .env` before running.
# For Aiven Apps: set these as the app's environment variables / secrets in the
# Aiven Apps setup (do NOT commit real values — .env is git-ignored).
#
# Kafka connection from the Aiven Console: Service > Connection information,
# authentication "SASL". The SASL_SSL port differs from the certificate/mTLS port.

export KAFKA_SERVICE_URI="<your-kafka-sasl-ssl-host>:<port>"
export KAFKA_USERNAME="avnadmin"
export KAFKA_PASSWORD="<your-kafka-password>"

# Optional. Defaults shown.
export KAFKA_TOPIC="order"
export ORDERS_PER_MINUTE="100"
