# live-orders configuration.
#
# For LOCAL dev: copy to .env, fill in values, then `source .env` before running.
# For Aiven Apps: set these as the app's environment variables / secrets in the
# Aiven Apps setup (do NOT commit real values — .env is git-ignored).
#
# Postgres connection from the Aiven Console: Service > Connection information
# (the "Service URI"). sslmode=require is part of the URI.

export POSTGRES_URI="postgres://avnadmin:<password>@<your-pg-host>:<port>/defaultdb?sslmode=require"

# Optional. Defaults shown.
export ORDERS_PER_MINUTE="100"
export UPDATES_PER_MINUTE="60"
