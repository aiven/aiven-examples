# query-agent configuration.
#
# LOCAL dev: copy to .env, fill in, then run (compose reads .env).
# Aiven Apps: set these as the app's env vars / secrets in the Aiven Apps setup.
# Never commit real values — .env is git-ignored.

# --- Amazon Bedrock ---
# Access key for the query-agent-bedrock IAM user (see setup-bedrock.sh).
export AWS_ACCESS_KEY_ID="<AccessKeyId>"
export AWS_SECRET_ACCESS_KEY="<SecretAccessKey>"
export AWS_REGION="eu-west-1"
export BEDROCK_MODEL_ID="eu.anthropic.claude-sonnet-4-6"

# --- Trino MCP endpoint (from query-app) ---
# Local (both on your machine): http://localhost:9097/mcp
# Aiven Apps: the externally-exposed mcp-trino URL, e.g. https://<app-host>/mcp
export TRINO_MCP_URL="http://localhost:9097/mcp"
# Bearer token when query-app has MCP_OAUTH_ENABLED=true (HMAC JWT signed with
# query-app's MCP_JWT_SECRET). Leave empty if MCP auth is disabled.
export TRINO_MCP_JWT=""
