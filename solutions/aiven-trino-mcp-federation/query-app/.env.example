# query-app configuration.
#
# LOCAL dev: copy to .env, fill in, then `docker compose up` (compose reads .env).
# Aiven Apps: set these as the app's env vars / secrets in the Aiven Apps setup.
# Never commit real values — .env is git-ignored.

# --- Snowflake Open Catalog (Iceberg REST catalog) ---
# Reuse the values from the aiven-iceberg-tutorial setup.
export ICEBERG_CATALOG_URI="https://<account>.us-west-2.snowflakecomputing.com/polaris/api/catalog"
export ICEBERG_OAUTH_CREDENTIAL="<client-id>:<client-secret>"
export ICEBERG_OAUTH_SCOPE="PRINCIPAL_ROLE:<your-principal-role>"
export ICEBERG_WAREHOUSE="<catalog-name>"

# --- Trino MCP endpoint auth (HMAC JWT) ---
# Local dev: leave disabled. Exposed deployment: set true + a strong secret.
export MCP_OAUTH_ENABLED="false"
export MCP_JWT_SECRET=""
