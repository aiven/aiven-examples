# Kafka connection for the Go producer (SASL_SSL + public Let's Encrypt CA).
# Copy to .env and fill in your values, then: source .env
#
# Get these from the Aiven Console: Service > Connection information,
# with authentication set to "SASL". Note the SASL_SSL port differs from
# the certificate/mTLS port.

export KAFKA_SERVICE_URI="<your-kafka-sasl-ssl-host>:<port>"
export KAFKA_USERNAME="avnadmin"
export KAFKA_PASSWORD="<your-kafka-password>"
