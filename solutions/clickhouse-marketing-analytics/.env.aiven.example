# Template for .env.aiven (which is git-ignored). Copy and fill in:
#   cp .env.aiven.example .env.aiven
# Values come from the Aiven console service overview, or from infra/:
#   terraform output -raw service_host ; terraform output -json https_port
# Usage:  set -a; source .env.aiven; set +a

AIVEN_CH_HOST=<service>-<project>.aivencloud.com
AIVEN_CH_PORT=8443
AIVEN_CH_DATABASE=campaign_analytics
AIVEN_CH_USER=avnadmin
AIVEN_CH_PASSWORD=<password>

# Aiven for Valkey - the durable ingestion buffer (terraform output -raw valkey_uri)
AIVEN_VALKEY_URI=rediss://default:<password>@<service>-<project>.aivencloud.com:<port>
# POST /events backend: valkey (production architecture) or memory (ladder tier 3)
INGEST_BUFFER=valkey
