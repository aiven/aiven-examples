# optime-publisher configuration.
#
# For LOCAL dev: copy to .env, fill in values, then `source .env` before running.
# For Aiven Apps: set these as the app's environment variables / secrets in the
# Aiven Apps setup (do NOT commit real values — .env is git-ignored).

# Hostname of the MQTT broker app (from its Aiven Apps deployment).
export MQTT_HOST="<your-broker-hostname>"
export MQTT_PASSWORD="<mqtt-password>"

# For a broker on Aiven Apps use WebSockets through the HTTPS ingress:
#   MQTT_TRANSPORT=websockets MQTT_TLS=true MQTT_PORT=443
# Optional. Defaults shown (raw MQTT for local dev).
export MQTT_PORT="1883"
export MQTT_USERNAME="iot"
export MQTT_TLS="false"
export MQTT_TRANSPORT="tcp"
export MACHINE_COUNT="14"            # number of simulated IoT devices
export PUBLISH_INTERVAL_SECONDS="5"  # seconds between publishes per device
export SITE="plant-herzogenaurach"   # run more instances with other sites for a multi-plant fleet
export TOPIC_PREFIX="optime"
export PORT="8080"                   # health-server port: /healthz, /readyz
